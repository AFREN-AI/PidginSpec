cabal-version: 3.0
name: reference-scorer
version: 0.1.0.0
build-type: Simple

library
  exposed-modules: Scoring
  hs-source-dirs: src
  build-depends:
      base >=4.18 && <5
    , aeson >=2.2
    , bytestring
    , containers
    , text
  default-language: Haskell2010
  ghc-options: -Wall -Werror

executable reference-scorer
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
      base >=4.18 && <5
    , bytestring
    , reference-scorer
  default-language: Haskell2010
  ghc-options: -Wall -Werror

test-suite reference-scorer-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test
  build-depends:
      base >=4.18 && <5
    , reference-scorer
    , text
  default-language: Haskell2010
  ghc-options: -Wall -Werror
